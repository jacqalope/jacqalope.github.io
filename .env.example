# Example env vars (DO NOT commit real secrets)
# Set these in Netlify site settings -> Build & deploy -> Environment

# OAuth2 credentials (create an OAuth client in Google Cloud Console)
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REFRESH_TOKEN=your-refresh-token-generated-locally-or-via-oauth-playground

# The Gmail account that will be used to send mail
SMTP_USER=you@gmail.com

# (Optional) "from" email — if omitted, SMTP_USER will be used
SEND_FROM_EMAIL=you@gmail.com

# Destination address where contact messages are sent
CONTACT_TO_EMAIL=me@mydomain.com